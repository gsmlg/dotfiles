;;; local.el.example --- Example machine-local GSMLG settings -*- lexical-binding: t; -*-

;;; Commentary:
;; Copy selected settings to:
;;
;;   ${XDG_CONFIG_HOME:-~/.config}/gsmlg/emacs-local.el
;;
;; or point GSMLG_EMACS_LOCAL at another file.  The tracked example is never
;; loaded automatically.  Keep secrets and private identities out of Git.

;;; Code:

;; Host-specific user data.
(setopt gsmlg-org-directory (expand-file-name "~/Documents/org/")
        gsmlg-org-agenda-files
        (expand-file-name ".agenda_files" gsmlg-org-directory)
        gsmlg-org-mobile-directory nil
        gsmlg-org-plantuml-jar-path nil)

;; External tools come from Nix, devenv, direnv, or the project.  Overrides
;; retain local/TRAMP execution because they are resolved near the buffer.
(setopt gsmlg-eglot-command-overrides
        '((elixir . ("expert" "--stdio"))
          (python . ("basedpyright-langserver" "--stdio"))))

;; Desktop and normal-process server startup are opt-in.  A daemon already
;; provides an emacsclient server.
(setopt gsmlg-desktop-save-enabled nil
        gsmlg-server-autostart nil)

;; Agent Editor MCP follows the server and starts one project-optional runtime.
(setopt gsmlg-agent-port 9876)

;; GSMLG AI Workbench (gptel) and inline completion (minuet) stay deferred.
;; Configure backends/credentials only in this private local file or auth-source.
;; Never put API keys in the tracked repository.
;;
;; Example gptel OpenAI-compatible backend (placeholders only):
;; (require 'gptel)
;; (setq gptel-model 'your-model
;;       gptel-backend
;;       (gptel-make-openai "local"
;;         :host "127.0.0.1:8080"
;;         :protocol "http"
;;         :stream t
;;         :key (lambda () (getenv "OPENAI_API_KEY"))
;;         :models '(your-model)))
;;
;; Example Minuet FIM-compatible provider (env var name, not the secret):
;; (setopt gsmlg-ai-completion-provider 'openai-fim-compatible)
;; (with-eval-after-load 'minuet
;;   (plist-put minuet-openai-fim-compatible-options
;;              :end-point "http://127.0.0.1:11434/v1/completions")
;;   (plist-put minuet-openai-fim-compatible-options :api-key "TERM")
;;   (plist-put minuet-openai-fim-compatible-options :model "qwen2.5-coder:3b"))

;; Optional fonts are applied only when present.
(setopt gsmlg-default-font-family "Source Code Pro"
        gsmlg-default-font-height 160
        gsmlg-cjk-font-family "Hiragino Sans GB")

;;; local.el.example ends here
