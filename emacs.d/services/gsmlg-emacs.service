[Unit]
Description=GSMLG Emacs server (main)
Documentation=file://%h/.config/emacs/README.md
After=default.target

[Service]
Type=forking
ExecStart=/usr/bin/env emacs --daemon=main
ExecStop=/usr/bin/env emacsclient -s main --eval '(save-buffers-kill-emacs t)'
Restart=on-failure
RestartSec=2
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_DATA_HOME=%h/.local/share
Environment=XDG_CACHE_HOME=%h/.cache
Environment=XDG_STATE_HOME=%h/.local/state

[Install]
WantedBy=default.target
