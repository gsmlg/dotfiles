[alias]
    br = branch
    co = checkout
    st = status
    cf = checkout -f
    cb = checkout -b
    df = diff --stat -b
    dh = diff HEAD
    logger = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%aI) %C(bold blue)<%an>%Creset' --abbrev-commit
    dw = diff --word-diff -b
    change-commits = "!f() { VAR=$1; OLD=$2; NEW=$3; shift 3; git filter-branch --env-filter \"if [[ \\\"$`echo $VAR`\\\" = '$OLD' ]]; then export $VAR='$NEW'; fi\" $@; }; f"
[user]
    name = Jonathan Gao
    email = gsmlg.com@gmail.com
[push]
    default = simple
[core]
    editor = nvim
    excludesfile = ~/.gitignore_global
    autocrlf = false
    filemode = true
    quotepath = false
    ignorecase = false
[branch]
    autosetupmerge = true
[color]
    ui = auto
[diff]
    mnemonicprefix = true
    tool = vimdiff
[filter "lfs"]
    clean = git-lfs clean -- %f
    process = git-lfs filter-process
    required = true
    smudge = git-lfs smudge -- %f
[merge]
    tool = splice
[pull]
    ff = only
    rebase = true
[init]
    defaultBranch = main
